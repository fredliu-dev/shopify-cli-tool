# 依赖
node_modules

# CLI 本地开发配置（不入库）
packages/cli/shopify.theme.toml
packages/cli/src/projects/

# 桌面应用构建产物
packages/desktop/dist
packages/desktop/out
packages/desktop/release
# build/ 是 electron-builder 的静态资源目录（图标等），不是产物；
# 忽略其中可能产生的杂物，但保留图标源文件
packages/desktop/build/*
!packages/desktop/build/icon.*

# 杂项
*.log
.DS_Store
